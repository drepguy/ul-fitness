    <path
        android:fillColor="#018786"
        android:pathData="M81,48h5a1,1 0 0 1 1,1v22a1,1 0 0 1 -1,1h-5a1.5,1.5 0 0 1 -1.5,-1.5v-21a1.5,1.5 0 0 1 1.5,-1.5z" />

