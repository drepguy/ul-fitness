# UL Fitness — ai-vm ~/ul-fitness/.env  (copy to .env, never commit — .gitignore:12)
# Alle Werte nur via Tailscale Subnet (http://ai-vm:8080) erreichbar, nicht öffentlich.

# MariaDB (Docker)
MARIADB_ROOT_PASSWORD=change_me_32plus_random_hex
MARIADB_DATABASE=ul_fitness
MARIADB_USER=ulf
MARIADB_PASSWORD=change_me_32plus_random_hex

# Ktor API
JWT_SECRET=change_me_64plus_random_hex_at_least_32_chars
# v1 nur du — nach initialem Seed false lassen; für Invite auf true
ALLOW_REGISTER=false
# LAN-Name via LXC Subnet-Router (kein MagicDNS, ai-vm hat keinen Tailscale-Daemon)
API_HOST=ai-vm
API_PORT=8080
# DB URL für Ktor (docker compose: db service)
DB_URL=jdbc:mariadb://db:3306/ul_fitness
